# The VS Code extension (apps/vscode). `vscode-nls-*` become package.nls*.json.
vscode-claimed-by = Claimed by { $label }: { $reason }
vscode-not-running = Polyph is not running on this computer. Start it with `polyph`, the desktop app, or the Start command.
vscode-start-failed = Could not start Polyph. Install the polyph command and make sure it is on PATH.
vscode-nls-description = See which voices hold which files, answer your agents and follow your Polyph room.
vscode-nls-command-open = Open
vscode-nls-command-approvals = Answer approvals
vscode-nls-command-startDaemon = Start the daemon
vscode-nls-config-home = The Polyph data directory, when it is not the default (POLYPH_HOME).
vscode-nls-config-claims = Mark files other voices have claimed, in their color.
vscode-nls-config-prompts = Ask about your agents' approvals as they arrive.
