# Emails from the hosted service (cloud/).
cloud-mail-code-subject = Your Polyph sign-in code
cloud-mail-code-body =
    Your Polyph sign-in code is { $code }.

    It works once, for 10 minutes. If you did not ask to sign in, ignore this email; nobody can sign in without the code.
cloud-mail-invite-subject = Join { $team } on Polyph
cloud-mail-invite-body =
    You were invited to the team { $team } on Polyph.

    Open this link to join. It works once, for 7 days:
    { $link }

    If you did not expect this, ignore this email.
